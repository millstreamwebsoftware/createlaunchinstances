#!/usr/bin/env bash

set -euo pipefail

readonly TEST_ACCOUNT_ID="450153405013"
readonly TEST_INSTANCE_ID="i-00000000000000001"
readonly OTHER_INSTANCE_ID="i-00000000000000002"
readonly OLD_IMAGE_ID="ami-00000000000000001"
readonly NEW_IMAGE_ID="ami-00000000000000002"
readonly PENDING_IMAGE_ID="ami-00000000000000003"
readonly OLD_SNAPSHOT_ID="snap-00000000000000001"
readonly NEW_SNAPSHOT_ID="snap-00000000000000002"

[[ -n "${MOCK_AWS_LOG:-}" ]] || {
    printf 'MOCK_AWS_LOG is required.\n' >&2
    exit 2
}
[[ -n "${MOCK_STATE_DIR:-}" ]] || {
    printf 'MOCK_STATE_DIR is required.\n' >&2
    exit 2
}

printf '%s\t' "$@" >> "$MOCK_AWS_LOG"
printf '\n' >> "$MOCK_AWS_LOG"

profile=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile)
            profile="$2"
            shift 2
            ;;
        --region)
            shift 2
            ;;
        --no-cli-pager)
            shift
            ;;
        *)
            break
            ;;
    esac
done

[[ -n "$profile" ]] || {
    printf 'Mock AWS call omitted --profile.\n' >&2
    exit 2
}
[[ $# -ge 2 ]] || {
    printf 'Mock AWS call has no service and operation.\n' >&2
    exit 2
}

service="$1"
operation="$2"
shift 2

option_value() {
    local wanted="$1"
    shift

    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "$wanted" ]]; then
            printf '%s\n' "$2"
            return
        fi
        shift
    done

    return 1
}

require_writes_enabled() {
    [[ "${MOCK_ALLOW_WRITES:-false}" == "true" ]] || {
        printf 'Unexpected mutating AWS call: %s %s\n' "$service" "$operation" >&2
        exit 90
    }
}

current_default_version() {
    if [[ -f "$MOCK_STATE_DIR/default-version" ]]; then
        sed -n '1p' "$MOCK_STATE_DIR/default-version"
    else
        printf '%s\n' "${MOCK_DEFAULT_VERSION:-24}"
    fi
}

template_data() {
    local image_id="$1"
    local mode="$2"

    jq -cn \
        --arg image_id "$image_id" \
        --arg old_snapshot "$OLD_SNAPSHOT_ID" \
        --arg mode "$mode" '
        {
            IamInstanceProfile: {
                Arn: "arn:aws:iam::450153405013:instance-profile/MillstreamProductionV2026Role"
            },
            NetworkInterfaces: [
                {
                    DeviceIndex: 0,
                    AssociatePublicIpAddress: true,
                    Groups: ["sg-00000000000000001", "sg-00000000000000002"]
                }
            ],
            ImageId: $image_id,
            InstanceType: "t3a.medium",
            KeyName: "webmaster-au",
            MetadataOptions: {HttpTokens: "required", HttpEndpoint: "enabled"},
            BlockDeviceMappings: [{DeviceName: "/dev/xvda", Ebs: {VolumeType: "gp3", VolumeSize: 20, Encrypted: true, DeleteOnTermination: true}}],
            UserData: "dGVzdA=="
        }
        | if $mode == "unsafe" then
            .Placement = {
                AvailabilityZone: "ap-southeast-2b",
                AvailabilityZoneId: "apse2-az1"
            }
            | .NetworkInterfaces[0].SubnetId = "subnet-00000000000000001"
            | .NetworkInterfaces[0].PrivateIpAddresses = [
                {Primary: true, PrivateIpAddress: "10.0.0.10"}
            ]
            | .BlockDeviceMappings = [
                {
                    DeviceName: "/dev/xvda",
                    Ebs: {SnapshotId: $old_snapshot, VolumeType: "gp3"}
                }
            ]
        elif $mode == "extra" then
            .MetadataOptions = {HttpTokens: "optional"}
        elif $mode == "no-public-ip" then
            .NetworkInterfaces[0].AssociatePublicIpAddress = false
        else
            .
        end
    '
}

image_data() {
    local image_id="$1"
    local snapshot_id="$2"
    local source_instance_id="$3"
    local state="$4"

    jq -cn \
        --arg image_id "$image_id" \
        --arg snapshot_id "$snapshot_id" \
        --arg source_instance_id "$source_instance_id" \
        --arg state "$state" '
        {
            ImageId: $image_id,
            Name: "millstream-production-v2026-test",
            State: $state,
            SourceInstanceId: $source_instance_id,
            Architecture: "x86_64",
            VirtualizationType: "hvm",
            RootDeviceName: "/dev/xvda",
            BlockDeviceMappings: [
                {
                    DeviceName: "/dev/xvda",
                    Ebs: {
                        SnapshotId: $snapshot_id,
                        VolumeType: "gp3",
                        VolumeSize: 20,
                        Encrypted: true,
                        DeleteOnTermination: true
                    }
                }
            ]
        }
    '
}

case "$service $operation" in
    "sts get-caller-identity")
        jq -cn --arg account "${MOCK_ACCOUNT_ID:-$TEST_ACCOUNT_ID}" '{Account: $account}'
        ;;
    "ec2 describe-launch-templates")
        default_version=$(current_default_version)
        latest_version=24
        if [[ -f "$MOCK_STATE_DIR/version-created" ]]; then
            latest_version=25
        fi
        jq -cn \
            --argjson default_version "$default_version" \
            --argjson latest_version "$latest_version" '
            {
                LaunchTemplates: [
                    {
                        LaunchTemplateId: "lt-03b872bbf73f81b5f",
                        LaunchTemplateName: "Millstream-Production-V2026",
                        DefaultVersionNumber: $default_version,
                        LatestVersionNumber: $latest_version
                    }
                ]
            }
        '
        ;;
    "ec2 describe-launch-template-versions")
        version=$(option_value --versions "$@")
        if [[ "$version" == "24" ]]; then
            data=$(template_data "$OLD_IMAGE_ID" "${MOCK_SOURCE_TEMPLATE_MODE:-clean}")
        elif [[ "$version" == "25" ]]; then
            created_image_id="$NEW_IMAGE_ID"
            if [[ -f "$MOCK_STATE_DIR/version-image-id" ]]; then
                created_image_id=$(sed -n '1p' "$MOCK_STATE_DIR/version-image-id")
            fi
            data=$(template_data "$created_image_id" "${MOCK_NEW_TEMPLATE_MODE:-clean}")
        else
            printf 'Unexpected launch template version: %s\n' "$version" >&2
            exit 2
        fi
        jq -cn --argjson version "$version" --argjson data "$data" '
            {LaunchTemplateVersions: [{VersionNumber: $version, LaunchTemplateData: $data}]}
        '
        ;;
    "ec2 describe-images")
        if option_value --image-ids "$@" >/dev/null 2>&1; then
            image_id=$(option_value --image-ids "$@")
            case "$image_id" in
                "$OLD_IMAGE_ID")
                    data=$(image_data "$OLD_IMAGE_ID" "$OLD_SNAPSHOT_ID" "$OTHER_INSTANCE_ID" "available")
                    ;;
                "$NEW_IMAGE_ID"|"$PENDING_IMAGE_ID")
                    data=$(image_data "$image_id" "$NEW_SNAPSHOT_ID" "$TEST_INSTANCE_ID" "available")
                    ;;
                *)
                    printf '{"Images":[]}\n'
                    exit 0
                    ;;
            esac
            jq -cn --argjson data "$data" '{Images: [$data]}'
        else
            case "${MOCK_PENDING_IMAGES:-none}" in
                none)
                    printf '{"Images":[]}\n'
                    ;;
                one)
                    jq -cn \
                        --arg image_id "$PENDING_IMAGE_ID" \
                        --arg source_instance_id "$TEST_INSTANCE_ID" '
                        {
                            Images: [
                                {
                                    ImageId: $image_id,
                                    Name: "millstream-production-v2026-pending",
                                    State: "pending",
                                    SourceInstanceId: $source_instance_id,
                                    CreationDate: "2026-08-31T00:00:00Z"
                                }
                            ]
                        }
                    '
                    ;;
                multiple)
                    jq -cn --arg source_instance_id "$TEST_INSTANCE_ID" '
                        {
                            Images: [
                                {
                                    ImageId: "ami-00000000000000003",
                                    Name: "millstream-production-v2026-pending-1",
                                    State: "pending",
                                    SourceInstanceId: $source_instance_id,
                                    CreationDate: "2026-08-31T00:00:00Z"
                                },
                                {
                                    ImageId: "ami-00000000000000004",
                                    Name: "millstream-production-v2026-pending-2",
                                    State: "pending",
                                    SourceInstanceId: $source_instance_id,
                                    CreationDate: "2026-08-31T00:01:00Z"
                                }
                            ]
                        }
                    '
                    ;;
                *)
                    printf 'Unknown MOCK_PENDING_IMAGES value.\n' >&2
                    exit 2
                    ;;
            esac
        fi
        ;;
    "ec2 describe-instances")
        jq -cn --arg instance_id "$TEST_INSTANCE_ID" \
            --arg instance_profile "${MOCK_INSTANCE_PROFILE:-MillstreamProductionV2026Role}" \
            --arg source_asg "${MOCK_SOURCE_ASG:-Millstream-Production-V2026}" '
            {
                Reservations: [
                    {
                        Instances: [
                            {
                                InstanceId: $instance_id,
                                InstanceType: "t3a.medium",
                                ImageId: "ami-00000000000000001",
                                VpcId: "vpc-03322748c5824b11f",
                                IamInstanceProfile: {Arn: ("arn:aws:iam::450153405013:instance-profile/" + $instance_profile)},
                                State: {Name: "running"},
                                Architecture: "x86_64",
                                VirtualizationType: "hvm",
                                Placement: {AvailabilityZone: "ap-southeast-2b"},
                                Tags: [
                                    {Key: "Name", Value: "test-source"},
                                    {
                                        Key: "aws:autoscaling:groupName",
                                        Value: $source_asg
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        '
        ;;
    "ec2 describe-instance-types")
        jq -cn '
            {
                InstanceTypes: [
                    {
                        InstanceType: "t3a.medium",
                        CurrentGeneration: true,
                        ProcessorInfo: {SupportedArchitectures: ["x86_64"]},
                        SupportedVirtualizationTypes: ["hvm"]
                    }
                ]
            }
        '
        ;;
    "autoscaling describe-auto-scaling-groups")
        asg_version="${MOCK_ASG_VERSION:-24}"
        if [[ -f "$MOCK_STATE_DIR/asg-version" ]]; then
            asg_version=$(cat "$MOCK_STATE_DIR/asg-version")
        fi
        asg_subnets="subnet-0a7cad8ec1ef2b0a7,subnet-0fe146e137aa3bec2"
        if [[ -f "$MOCK_STATE_DIR/version-created" && ! -f "$MOCK_STATE_DIR/asg-version" ]]; then
            if [[ "${MOCK_CONCURRENT_ASG_VERSION:-false}" == true ]]; then asg_version=26; fi
            if [[ "${MOCK_CONCURRENT_SUBNETS:-false}" == true ]]; then asg_subnets=other-subnet; fi
        fi
        jq -cn \
            --arg selected "$TEST_INSTANCE_ID" \
            --arg selected_health "${MOCK_SELECTED_INSTANCE_HEALTH:-Healthy}" \
            --arg other "$OTHER_INSTANCE_ID" \
            --arg version "$asg_version" \
            --arg template "${MOCK_ASG_TEMPLATE:-lt-03b872bbf73f81b5f}" \
            --arg subnets "$asg_subnets" \
            --arg mixed "${MOCK_MIXED_POLICY:-false}" '
            {
                AutoScalingGroups: [
                    {
                        AutoScalingGroupName: "Millstream-Production-V2026",
                        LaunchTemplate: {LaunchTemplateId: $template, LaunchTemplateName: "Millstream-Production-V2026", Version: $version},
                        VPCZoneIdentifier: $subnets,
                        MinSize: 2, MaxSize: 6, DesiredCapacity: 2,
                        Instances: [
                            {InstanceId: $selected, HealthStatus: $selected_health, LifecycleState: "InService"},
                            {InstanceId: $other, HealthStatus: "Healthy", LifecycleState: "InService"}
                        ]
                    }
                ]
            }
            | if $mixed == "true" then .AutoScalingGroups[0].MixedInstancesPolicy = {} else . end
        '
        ;;
    "autoscaling update-auto-scaling-group")
        require_writes_enabled
        if [[ "${MOCK_ASG_UPDATE_FAILURE:-false}" == true ]]; then exit 91; fi
        selection=$(option_value --launch-template "$@")
        [[ "$selection" == 'LaunchTemplateId=lt-03b872bbf73f81b5f,Version=25' ]] || exit 92
        if [[ "${MOCK_ASG_READBACK_MISMATCH:-false}" != true ]]; then
            printf '25\n' > "$MOCK_STATE_DIR/asg-version"
        fi
        if [[ "${MOCK_CONCURRENT_DEFAULT_AFTER_ASG:-false}" == true ]]; then
            printf '26\n' > "$MOCK_STATE_DIR/default-version"
        fi
        printf '{}\n'
        ;;
    "ec2 create-image")
        require_writes_enabled
        jq -cn --arg image_id "$NEW_IMAGE_ID" '{ImageId: $image_id}'
        ;;
    "ec2 create-launch-template-version")
        require_writes_enabled
        launch_template_data=$(option_value --launch-template-data "$@")
        created_image_id=$(printf '%s\n' "$launch_template_data" | jq -er '.ImageId')
        printf '%s\n' "$created_image_id" > "$MOCK_STATE_DIR/version-image-id"
        printf 'created\n' > "$MOCK_STATE_DIR/version-created"
        if [[ "${MOCK_CONCURRENT_DEFAULT:-false}" == true ]]; then
            printf '26\n' > "$MOCK_STATE_DIR/default-version"
        fi
        jq -cn '{LaunchTemplateVersion: {VersionNumber: 25}}'
        ;;
    "ec2 modify-launch-template")
        require_writes_enabled
        if [[ "${MOCK_DEFAULT_UPDATE_FAILURE:-false}" == true ]]; then exit 93; fi
        version=$(option_value --default-version "$@")
        printf '%s\n' "$version" > "$MOCK_STATE_DIR/default-version"
        jq -cn --argjson version "$version" '
            {LaunchTemplate: {DefaultVersionNumber: $version}}
        '
        ;;
    *)
        printf 'Unexpected mock AWS operation: %s %s\n' "$service" "$operation" >&2
        exit 2
        ;;
esac
